{
  "name": "pcbx2energy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Text-to-PCB AI designer with 2D/3D preview and Gerber/BOM/PnP export for JLCPCB, PCBWay and OSH Park",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "jszip": "^3.10.2",
    "occt-import-js": "^0.0.23",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
